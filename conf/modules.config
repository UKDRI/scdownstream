/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
    ]

    withName: '.*:LOAD_H5AD:ADATA_READRDS' {
        ext.prefix = { meta.id + '_converted_' + meta.type }
        publishDir = [
            path: { "${params.outdir}/load_h5ad" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: '.*:LOAD_H5AD:SCANPY_READH5' {
        ext.prefix = { meta.id + '_converted_' + meta.type }
        publishDir = [
            path: { "${params.outdir}/load_h5ad" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: '.*:LOAD_H5AD:ADATA_READCSV' {
        ext.prefix = { meta.id + '_converted_' + meta.type }
        publishDir = [
            path: { "${params.outdir}/load_h5ad" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    // Sample id and per-sample metadata (--metadata) added to obs

    withName: ADATA_ADDSAMPLE {
        ext.prefix = { meta.id + '_sample' }
        publishDir = [
            path: { "${params.outdir}/load" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: ADATA_ADDMETADATA {
        ext.prefix = { meta.id + '_metadata' }
        publishDir = [
            path: { "${params.outdir}/load" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    // Size extraction
    withName: 'GET_.*_SIZE' {
        publishDir = [
            enabled: params.save_intermediates,
        ]
    }

    withName: COLLECT_SIZES {
        publishDir = [
            path: { "${params.outdir}/quality_control/sizes" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') || filename.endsWith('.json') ? null : filename },
        ]
    }

    // Empty droplet removal

    withName: '.*:EMPTY_DROPLET_REMOVAL:CELLBENDER_REMOVEBACKGROUND' {
        ext.prefix = { meta.id + '_cellbender' }
        ext.args   = {
            [
                "--epochs ${params.cellbender_epochs}",
                meta.expected_cells > 0 ? "--expected-cells ${meta.expected_cells}" : '',
            ].join(' ').trim()
        }
        publishDir = [
            path: { "${params.outdir}/quality_control/empty_droplet_removal" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: '.*:EMPTY_DROPLET_REMOVAL:ANNDATA_BARCODES' {
        ext.prefix = { meta.id + '_subset' }
        publishDir = [
            path: { "${params.outdir}/quality_control/empty_droplet_removal" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    // Quality control

    withName: QC_RAW {
        ext.prefix       = { meta.id + '_raw' }
        ext.section_name = 'Unfiltered QC plots'
        publishDir       = [
            path: { "${params.outdir}/quality_control/qc_raw" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') || filename.endsWith('.json') ? null : filename },
        ]
    }

    withName: QC_FILTERED {
        ext.prefix       = { meta.id + '_preprocessed' }
        ext.section_name = 'Filtered QC plots'
        publishDir       = [
            path: { "${params.outdir}/quality_control/qc_filtered" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') || filename.endsWith('.json') ? null : filename },
        ]
    }

    // Ambient RNA removal

    withName: CELDA_DECONTX {
        ext.prefix = { meta.id + '_decontx' }
        ext.batch_col = { meta.batch_col }
        publishDir = [
            path: { "${params.outdir}/quality_control/ambient_rna_removal" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: '.*:AMBIENT_RNA_REMOVAL:CELLBENDER_REMOVEBACKGROUND' {
        ext.prefix = { meta.id + '_cellbender' }
        ext.args   = { "--epochs ${params.cellbender_epochs}" }
        publishDir = [
            path: { "${params.outdir}/quality_control/ambient_rna_removal" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: '.*:AMBIENT_RNA_REMOVAL:CELLBENDER_MERGE' {
        ext.prefix       = { meta.id + '_cellbender' }
        publishDir       = [
            path: { "${params.outdir}/quality_control/ambient_rna_removal" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: SOUPX {
        ext.prefix = { meta.id + '_soupX' }
        publishDir = [
            path: { "${params.outdir}/quality_control/ambient_rna_removal" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    // Custom filtering

    withName: SCANPY_FILTER {
        ext.prefix = { meta.id + '_filtered' }
        publishDir = [
            path: { "${params.outdir}/quality_control/custom_thresholds" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    // Only the QC call: the INTEGRATE call drops zero-count cells before scVI and must keep removing them
    withName: '.*:QUALITY_CONTROL:SCANPY_FILTER' {
        ext.keep_outliers = { params.filtering_keep_outliers }
    }

    // Doublet detection

    withName: SCVITOOLS_SOLO {
        ext.prefix = { meta.id + '_solo' }
        ext.batch_key = { meta.batch_col }
        publishDir = [
            path: { "${params.outdir}/quality_control/doublet_detection/solo" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: SCANPY_SCRUBLET {
        ext.prefix = { meta.id + '_scrublet' }
        publishDir = [
            path: { "${params.outdir}/quality_control/doublet_detection/scrublet" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: DOUBLETDETECTION {
        ext.prefix = { meta.id + '_doubletdetection' }
        publishDir = [
            path: { "${params.outdir}/quality_control/doublet_detection/doubletdetection" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: SCDS {
        ext.prefix = { meta.id + '_scds' }
        publishDir = [
            path: { "${params.outdir}/quality_control/doublet_detection/scds" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: DOUBLET_REMOVAL {
        ext.prefix = { meta.id + '_dedoubleted' }
        publishDir = [
            path: { "${params.outdir}/quality_control/doublet_detection" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') || filename.endsWith('.json') ? null : filename },
        ]
    }

    withName: FINALIZE_QC_ANNDATAS {
        ext.prefix = { meta.id + '_qc' }
        publishDir = [
            path: { "${params.outdir}/quality_control/finalized" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: MYGENE {
        ext.prefix = { meta.id + '_mygene' }
        ext.input_col = { meta.geneid_col }
        ext.output_col = { 'symbols' }
        publishDir = [
            enabled: false
        ]
    }

    withName: SET_INDEX {
        ext.axis = 'var'
        ext.column = { meta.symbol_col }
        publishDir = [
            enabled: false
        ]
    }

    withName: HUGOUNIFIER_GET {
        publishDir = [
            path: { "${params.outdir}/unify/hugounifier" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: HUGOUNIFIER_APPLY {
        ext.prefix = { meta.id + '_hugounifier' }
        publishDir = [
            path: { "${params.outdir}/unify/hugounifier" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: ADATA_UNIFY {
        ext.prefix             = { meta.id + '_unified' }
        ext.symbol_col         = { meta.symbol_col }
        ext.geneid_col         = { meta.geneid_col }
        ext.counts_layer       = { meta.counts_layer }
        ext.duplicate_var_resolution = { params.duplicate_var_resolution }
        ext.batch_col                = { meta.batch_col }
        ext.label_col                = { meta.label_col }
        ext.unknown_label            = { meta.unknown_label }
        publishDir             = [
            path: { "${params.outdir}/unify" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    // Merge datasets

    withName: ADATA_MERGE {
        // merge.py keeps only the obs columns shared by all objects, --base_adata included.
        // Force 'sample' and the --metadata columns through so they are not dropped when the
        // base lacks them; its cells then get 'unknown' (or NaN for numeric columns).
        ext.force_obs_cols = {
            def metadata_cols = params.metadata
                ? (nextflow.Nextflow.file(params.metadata).withReader { reader -> reader.readLine() } ?: '')
                    .replace('\uFEFF', '')
                    .split('\t')*.trim()
                    .findAll { col -> col != params.metadata_sample_col }
                : []
            ((params.force_obs_cols ?: '').tokenize(',')*.trim() + ['sample'] + metadata_cols)
                .findAll { col -> col }
                .unique()
                .join(',')
        }
        publishDir = [
            path: { "${params.outdir}/combine/merge" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: ADATA_UPSETGENES {
        publishDir = [
            path: { "${params.outdir}/combine/merge" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') || filename.endsWith('.json') ? null : filename },
        ]
    }

    withName: 'ADATA_ADD_OBS_OBSM|.*:INTEGRATE:ADD_SCANVI_RESULTS' {
        publishDir = [
            path: { "${params.outdir}/adata/" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    // Prepare integration

    withName: SCANPY_HVGS {
        ext.prefix = { meta.id + '_hvg' }
        ext.n_hvgs = { meta.n_hvgs }
        publishDir = [
            path: { "${params.outdir}/combine/integrate/input_hvg" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: '.*:INTEGRATE:ADATA_TORDS' {
        publishDir = [
            path: { "${params.outdir}/combine/integrate/input_hvg" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    // Integration

    withName: SCVITOOLS_SCVI {
        ext.n_hidden               = { params.scvi_n_hidden }
        ext.n_layers               = { params.scvi_n_layers }
        ext.n_latent               = { params.scvi_n_latent }
        ext.dispersion             = { params.scvi_dispersion }
        ext.gene_likelihood        = { params.scvi_gene_likelihood }
        ext.max_epochs             = { params.scvi_max_epochs }
        ext.query_max_epochs       = { params.scvi_query_max_epochs }
        ext.categorical_covariates = { params.scvi_categorical_covariates }
        ext.continuous_covariates  = { params.scvi_continuous_covariates }
        publishDir                 = [
            path: { "${params.outdir}/combine/integrate/scvi" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.endsWith("model.pt") || (params.save_intermediates && !filename.equals('versions.yml')) ? filename : null },
        ]
    }

    withName: SCVITOOLS_SCANVI {
        ext.n_hidden               = { params.scvi_n_hidden }
        ext.n_layers               = { params.scvi_n_layers }
        ext.n_latent               = { params.scvi_n_latent }
        ext.dispersion             = { params.scvi_dispersion }
        ext.gene_likelihood        = { params.scvi_gene_likelihood }
        ext.max_epochs             = { params.scvi_max_epochs }
        ext.query_max_epochs       = { params.scvi_query_max_epochs }
        ext.categorical_covariates = { params.scvi_categorical_covariates }
        ext.continuous_covariates  = { params.scvi_continuous_covariates }
        publishDir                 = [
            path: { "${params.outdir}/combine/integrate/scanvi" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.endsWith("model.pt") || (params.save_intermediates && !filename.equals('versions.yml')) ? filename : null },
        ]
    }

    withName: SCANPY_HARMONY {
        publishDir = [
            path: { "${params.outdir}/combine/integrate/harmony" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: INTEGRATION_BBKNN {
        publishDir = [
            path: { "${params.outdir}/combine/integrate/bbknn" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: SEURAT_INTEGRATION {
        publishDir = [
            path: { "${params.outdir}/combine/integrate/seurat" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: '.*:INTEGRATE:ADATA_READRDS' {
        publishDir = [
            enabled: false
        ]
    }

    withName: SCANPY_COMBAT {
        publishDir = [
            path: { "${params.outdir}/combine/integrate/combat" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: '.*:SCIMILARITY:UNTAR' {
        publishDir = [
            enabled: false
        ]
    }

    withName: SCIMILARITY_EMBED {
        publishDir = [
            path: { "${params.outdir}/combine/integrate/scimilarity" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: SCIMILARITY_ANNOTATE {
        ext.prefix = { meta.id + '_annotate' }
        publishDir = [
            path: { "${params.outdir}/combine/integrate/scimilarity" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: ADATA_MERGEEMBEDDINGS {
        publishDir = [
            path: { "${params.outdir}/combine/merge_emb/${meta.id}" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    // Celltype assignment

    withName: CELLTYPES_CELLTYPIST {
        ext.prefix = { meta.id + '_celltypist' }
        publishDir = [
            path: { "${params.outdir}/celltypes/celltypist" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    // Clustering

    withName: NEIGHBORS {
        ext.prefix = { meta.id + '_neighbors' }
        publishDir = [
            path: { "${params.outdir}/cluster_dimred/${meta.integration}/neighbors" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: LEIDEN {
        ext.prefix = { meta.id + '_leiden' }
        publishDir = [
            path: { "${params.outdir}/cluster_dimred/${meta.integration}/leiden" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.endsWith(".png") || (params.save_intermediates && !filename.equals('versions.yml')) ? filename : null },
        ]
    }

    withName: ENTROPY {
        ext.prefix = { meta.id + '_entropy' }
        ext.plot_basis = 'umap'
        publishDir = [
            path: { "${params.outdir}/cluster_dimred/${meta.integration}/entropy" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.endsWith(".png") || (params.save_intermediates && !filename.equals('versions.yml')) ? filename : null },
        ]
    }

    // SCANPY_UMAP runs twice on the same meta.id (integrated_scvi): once on the scVI graph in
    // INTEGRATE and once on the PCA graph in QC_CLUSTER, so each call needs its own prefix.
    // The publishDir comes from the generic withName: SCANPY_UMAP block further down.
    withName: '.*:INTEGRATE:SCANPY_UMAP' {
        ext.prefix = { meta.id + '_umap_SCVI' }
    }

    withName: '.*:QC_CLUSTER:SCANPY_UMAP' {
        // The PCA-based UMAP is stored as X_umap_pca; X_umap is a copy for tools that expect it
        ext.prefix    = { meta.id + '_umap_PCA' }
        ext.alias_key = 'X_umap'
    }

    withName: UMAP {
        ext.prefix = { meta.id + '_umap' }
        publishDir = [
            path: { "${params.outdir}/cluster_dimred/${meta.integration}/umap" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.endsWith(".png") || (params.save_intermediates && !filename.equals('versions.yml')) ? filename : null },
        ]
    }

    withName: ".*:PSEUDOBULKING:PSEUDOBULK" {
        ext.prefix = { meta.id + '_pseudobulk' }
        publishDir = [
            path: { "${params.outdir}/pseudobulking" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }
    withName: SCANPY_PAGA {
        ext.prefix = { meta.id + '_paga' }
        publishDir = [
            path: { "${params.outdir}/per_group/${meta.id}/paga" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.endsWith(".png") || (params.save_intermediates && !filename.equals('versions.yml')) ? filename : null },
        ]
    }

    withName: LIANA_RANKAGGREGATE {
        ext.prefix = { meta.id + '_liana' }
        publishDir = [
            path: { "${params.outdir}/per_group/${meta.id}/liana" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> params.save_intermediates && !filename.equals('versions.yml') ? filename : null },
        ]
    }

    withName: SCANPY_LOG_NORMALIZE {
        ext.prefix = { meta.id + '_log_normalize' }
        publishDir = [
            path: { "${params.outdir}/scanpy/${meta.id}/" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> params.save_intermediates && !filename.equals('versions.yml') ? filename : null },
        ]
    }


    withName: SCANPY_NEIGHBORS {
        ext.prefix = { meta.id + '_neighbors' }
        publishDir = [
            path: { "${params.outdir}/scanpy/${meta.id}/" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> params.save_intermediates && !filename.equals('versions.yml') ? filename : null },
        ]
    }

    // Same meta.id for the scVI (INTEGRATE) and PCA (QC_CLUSTER) calls; these override the
    // generic prefix above so the two published graphs do not overwrite each other.
    withName: '.*:INTEGRATE:SCANPY_NEIGHBORS' {
        ext.prefix = { meta.id + '_neighbors_SCVI' }
    }

    withName: '.*:QC_CLUSTER:SCANPY_NEIGHBORS' {
        ext.prefix = { meta.id + '_neighbors_PCA' }
        ext.n_pcs  = { params.neighbors_n_pcs }
    }

    // Prefixes are set per call site in the Clustering section above; this block only publishes.
    withName: SCANPY_UMAP {
        publishDir = [
            path: { "${params.outdir}/scanpy/${meta.id}/" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> params.save_intermediates && !filename.equals('versions.yml') ? filename : null },
        ]
    }


    withName: SCANPY_LEIDEN {
        ext.prefix = { meta.id + '_leiden' }
        publishDir = [
            path: { "${params.outdir}/scanpy/${meta.id}/" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> params.save_intermediates && !filename.equals('versions.yml') ? filename : null },
        ]
    }

    withName: SCANPY_PCA {
        ext.prefix = { meta.id + '_pca' }
        publishDir = [
            path: { "${params.outdir}/scanpy/${meta.id}/" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> params.save_intermediates && !filename.equals('versions.yml') ? filename : null },
        ]
    }

    withName: '.*:QC_CLUSTER:SCANPY_PCA' {
        ext.n_comps = { params.pca_n_comps }
    }

    withName: SCANPY_RANKGENESGROUPS {
        ext.prefix = { meta.id + '_characteristic_genes' }
        publishDir = [
            path: { "${params.outdir}/scanpy/${meta.id}/" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> params.save_intermediates && !filename.equals('versions.yml') ? filename : null },
        ]
    }

    withName: SCANPY_ENRICH {
        ext.prefix = { meta.id + '_enriched' }
        publishDir = [
            path: { "${params.outdir}/scanpy/${meta.id}/" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> params.save_intermediates && !filename.equals('versions.yml') ? filename : null },
        ]
    }

    // Differential genes (--stage differential_genes)

    withName: DECOUPLER_PSEUDOBULK {
        ext.prefix = { meta.id + '_pseudobulk' }
        publishDir = [
            path: { "${params.outdir}/differential_genes/pseudobulk" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> params.save_intermediates && !filename.equals('versions.yml') ? filename : null },
        ]
    }

    withName: FILTER_PSEUDOBULK {
        ext.prefix = { meta.id + '_pseudobulk_filtered' }
        publishDir = [
            path: { "${params.outdir}/differential_genes/pseudobulk" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> params.save_intermediates && !filename.equals('versions.yml') ? filename : null },
        ]
    }

    // The split writes one file per instance of the group label, named after the obs
    // value itself, so ext.prefix has no effect here - the dedicated directory keeps
    // those bare names from colliding with anything else.
    withName: SPLIT_PER_GROUP {
        publishDir = [
            path: { "${params.outdir}/differential_genes/pseudobulk/per_group" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> params.save_intermediates && !filename.equals('versions.yml') ? filename : null },
        ]
    }

    // One task per (group label instance x contrast), all sharing the same meta.id, so the
    // prefix has to carry meta.subset to keep the published CSVs from overwriting each
    // other. The contrast name is appended by the template itself.
    withName: DIFFERENTIAL_GENES_PER_CONTRAST {
        ext.prefix = { meta.id + '_' + meta.subset }
        publishDir = [
            path: { "${params.outdir}/differential_genes/deseq2/${meta.subset}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    // Marker-gene JSON of the differential_genes stage, published next to the downstream
    // markers JSON (cf. '.*:FINALIZE_H5AD:SCANPY_EXPORT_MARKERS').
    withName: PYDESEQ2_EXPORT_MARKERS {
        ext.prefix = { "${params.name ?: 'scdownstream'}_differential_genes" }
        publishDir = [
            path: { "${params.outdir}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    // The HTML report is a primary output of the stage, so it publishes
    // unconditionally like the DESeq2 result tables above.
    withName: PYDESEQ2_GENERATE_REPORT {
        ext.prefix = { meta.id + '_differential_genes_report' }
        publishDir = [
            path: { "${params.outdir}/report" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    // Model training (--stage train_models)
    //
    // meta.name is the model name N. The models of the evaluation are trained on the training
    // split; with --train_final_on_all false they are named N themselves and kept as the final
    // models, so they are published to the final paths. Models, the reference h5ad, the evaluation
    // tables and the report are always published under models/ (the report under report/);
    // everything else only with --save_intermediates, under models/intermediates/.

    withName: '.*:TRAIN_MODELS:ADATA_TRAINSPLIT' {
        ext.label_col           = { params.train_label_col }
        ext.unknown_label       = { params.train_unknown_label }
        ext.batch_col           = { params.train_batch_col }
        ext.counts_layer        = { params.train_counts_layer }
        ext.symbol_col          = { params.train_symbol_col }
        ext.min_cells_per_label = { params.train_min_cells_per_label }
        ext.test_fraction       = { params.train_test_fraction }
        ext.split_by            = { params.train_test_split_by }
        ext.evaluate            = { params.train_evaluate == null ? true : params.train_evaluate.toString().trim().toLowerCase() in ['true', 'yes', '1'] }
        ext.max_cells_per_label = { params.train_max_cells_per_label ?: 0 }
        publishDir              = [
            path: { "${params.outdir}/models" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                filename.endsWith('_label_counts.tsv') ? "evaluation/${filename}"
                    : params.save_intermediates && !filename.equals('versions.yml') ? "intermediates/trainsplit/${filename}"
                    : null
            },
        ]
    }

    withName: '.*:TRAIN_MODELS:CELLTYPIST_TRAIN_(EVAL|FINAL)' {
        ext.feature_selection = { params.train_celltypist_feature_selection == null ? true : params.train_celltypist_feature_selection.toString().trim().toLowerCase() in ['true', 'yes', '1'] }
        ext.use_sgd           = { params.train_celltypist_use_sgd == null ? false : params.train_celltypist_use_sgd.toString().trim().toLowerCase() in ['true', 'yes', '1'] }
        ext.mini_batch        = { params.train_celltypist_mini_batch == null ? false : params.train_celltypist_mini_batch.toString().trim().toLowerCase() in ['true', 'yes', '1'] }
        ext.batch_size        = { params.train_celltypist_batch_size ?: 1000 }
    }

    withName: '.*:TRAIN_MODELS:CELLTYPIST_TRAIN_FINAL' {
        publishDir = [
            path: { "${params.outdir}/models" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.endsWith('.pkl') ? "celltypist/${meta.name}.pkl" : null },
        ]
    }

    withName: '.*:TRAIN_MODELS:CELLTYPIST_TRAIN_EVAL' {
        publishDir = [
            path: { "${params.outdir}/models" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                // Command-line params are strings: convert; null is the default (true)
                def evaluate = params.train_evaluate == null || params.train_evaluate.toString().trim().toLowerCase() in ['true', 'yes', '1']
                def final_on_all = params.train_final_on_all == null || params.train_final_on_all.toString().trim().toLowerCase() in ['true', 'yes', '1']
                // with --train_final_on_all false the evaluation models are the final models
                def keep_eval = evaluate && !final_on_all
                !filename.endsWith('.pkl') ? null
                    : keep_eval ? "celltypist/${meta.name}.pkl"
                    : params.save_intermediates ? "intermediates/celltypist/${filename}"
                    : null
            },
        ]
    }

    withName: '.*:TRAIN_MODELS:CELLTYPIST_PREDICT_TEST' {
        publishDir = [
            path: { "${params.outdir}/models/intermediates/celltypist" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    // HVGs for the scVI/scANVI reference, selected on the raw counts per batch. seurat_v3 is the
    // usual choice for this, but needs a container with scikit-misc, which the SCANPY_HVGS image
    // lacks; it may replace pearson_residuals after a re-evaluation.
    withName: '.*:TRAIN_MODELS:HVGS_(EVAL|FINAL)' {
        ext.prefix    = { meta.id + '_hvg' }
        ext.flavor    = 'pearson_residuals'
        ext.batch_key = 'batch'
        publishDir    = [
            path: { "${params.outdir}/models/intermediates/hvgs" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    // withName: SCVITOOLS_SCVI / SCVITOOLS_SCANVI do not match these aliases: same settings here,
    // also because a query inherits the architecture of the saved model
    withName: '.*:TRAIN_MODELS:(SCVI_EVAL|SCVI_FINAL|SCANVI_EVAL|SCANVI_QUERY_TEST|SCANVI_FINAL)' {
        ext.n_hidden               = { params.scvi_n_hidden }
        ext.n_layers               = { params.scvi_n_layers }
        ext.n_latent               = { params.scvi_n_latent }
        ext.dispersion             = { params.scvi_dispersion }
        ext.gene_likelihood        = { params.scvi_gene_likelihood }
        ext.max_epochs             = { params.scvi_max_epochs }
        ext.query_max_epochs       = { params.scvi_query_max_epochs }
        ext.categorical_covariates = { params.scvi_categorical_covariates }
        ext.continuous_covariates  = { params.scvi_continuous_covariates }
    }

    withName: '.*:TRAIN_MODELS:SCVI_FINAL' {
        publishDir = [
            path: { "${params.outdir}/models" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                filename.endsWith('model.pt') ? "scvi/${meta.name}/model.pt"
                    : params.save_intermediates && !filename.equals('versions.yml') ? "intermediates/scvi/${filename}"
                    : null
            },
        ]
    }

    withName: '.*:TRAIN_MODELS:SCVI_EVAL' {
        publishDir = [
            path: { "${params.outdir}/models" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                // Command-line params are strings: convert; null is the default (true)
                def evaluate = params.train_evaluate == null || params.train_evaluate.toString().trim().toLowerCase() in ['true', 'yes', '1']
                def final_on_all = params.train_final_on_all == null || params.train_final_on_all.toString().trim().toLowerCase() in ['true', 'yes', '1']
                // with --train_final_on_all false the evaluation models are the final models
                def keep_eval = evaluate && !final_on_all
                filename.equals('versions.yml') ? null
                    : filename.endsWith('model.pt') && keep_eval ? "scvi/${meta.name}/model.pt"
                    : params.save_intermediates ? "intermediates/scvi/${filename}"
                    : null
            },
        ]
    }

    withName: '.*:TRAIN_MODELS:SCANVI_FINAL' {
        publishDir = [
            path: { "${params.outdir}/models" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                filename.endsWith('model.pt') ? "scanvi/${meta.name}/model.pt"
                    : filename.endsWith('.h5ad') ? "${meta.name}_reference.h5ad"
                    : params.save_intermediates && !filename.equals('versions.yml') ? "intermediates/scanvi/${filename}"
                    : null
            },
        ]
    }

    withName: '.*:TRAIN_MODELS:SCANVI_EVAL' {
        publishDir = [
            path: { "${params.outdir}/models" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                // Command-line params are strings: convert; null is the default (true)
                def evaluate = params.train_evaluate == null || params.train_evaluate.toString().trim().toLowerCase() in ['true', 'yes', '1']
                def final_on_all = params.train_final_on_all == null || params.train_final_on_all.toString().trim().toLowerCase() in ['true', 'yes', '1']
                // with --train_final_on_all false the evaluation models are the final models
                def keep_eval = evaluate && !final_on_all
                filename.equals('versions.yml') ? null
                    : filename.endsWith('model.pt') && keep_eval ? "scanvi/${meta.name}/model.pt"
                    : filename.endsWith('.h5ad') && keep_eval ? "${meta.name}_reference.h5ad"
                    : params.save_intermediates ? "intermediates/scanvi/${filename}"
                    : null
            },
        ]
    }

    withName: '.*:TRAIN_MODELS:SCANVI_QUERY_TEST' {
        publishDir = [
            path: { "${params.outdir}/models/intermediates/scanvi" },
            mode: params.publish_dir_mode,
            enabled: params.save_intermediates,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    // File names start with meta.method (MODEL_EVALUATE's default prefix), so the tables of all
    // methods can be collected into one report input
    withName: '.*:TRAIN_MODELS:EVALUATE_(CELLTYPIST|SCANVI)' {
        publishDir = [
            path: { "${params.outdir}/models/evaluation/${meta.method}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: '.*:TRAIN_MODELS:SCANPY_GENERATE_REPORT_TRAINING' {
        ext.prefix = { "${meta.name}_training_report" }
        publishDir = [
            path: { "${params.outdir}/report" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    // Finalize

    withName: SCANPY_GENERATE_REPORT {
        ext.prefix = { "${params.name ?: 'scdownstream'}_downstream_report" }
        publishDir = [
            path: { "${params.outdir}/report" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: SCANPY_GENERATE_REPORT_QC {
        ext.prefix = { "${params.name ?: 'scdownstream'}_qc_clustering_report" }
        publishDir = [
            path: { "${params.outdir}/report" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    // MultiQC
    withName: MULTIQC {
        ext.args   = { params.multiqc_title ? "--title \"${params.multiqc_title}\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: '.*:FINALIZE_H5AD:ADATA_TORDS' {
        errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'ignore' }
        ext.prefix = { "${params.name ?: 'scdownstream'}_downstream" }
        publishDir    = [
            path: { "${params.outdir}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: '.*:FINALIZE_H5AD_SIMPLE:ADATA_TORDS' {
        errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'ignore' }
        ext.prefix = { "${params.name ?: 'scdownstream'}_qc_clustering" }
        publishDir    = [
            path: { "${params.outdir}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: '.*:FINALIZE_H5AD:ADATA_PUBLISH' {
        ext.prefix = { "${params.name ?: 'scdownstream'}_downstream" }
        publishDir = [
            path: { "${params.outdir}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: '.*:FINALIZE_H5AD_SIMPLE:ADATA_PUBLISH' {
        ext.prefix = { "${params.name ?: 'scdownstream'}_qc_clustering" }
        publishDir = [
            path: { "${params.outdir}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }


    withName: '.*:FINALIZE_H5AD:SCANPY_EXPORT_MARKERS' {
        ext.prefix = { "${params.name ?: 'scdownstream'}_downstream_markers" }
        publishDir = [
            path: { "${params.outdir}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }
}
