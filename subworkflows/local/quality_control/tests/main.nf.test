nextflow_workflow {

    name "Test Workflow QUALITY_CONTROL"
    script "subworkflows/local/quality_control/main.nf"
    workflow "QUALITY_CONTROL"

    tag "subworkflows"
    tag "subworkflows_local"

    test("Should run without ambient RNA removal and doublet detection") {

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = Channel.of([
                        [ id: 'test', batch_col: 'sample', counts_layer: 'X' ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679756_filtered_matrix.h5ad', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679756_raw_matrix.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = 'none'
                input[2] = []
                input[3] = 0
                """
            }
        }

        then {
            assert workflow.success
            assert snapshot(workflow.out).match()
        }

    }

    test("Should run with ambient RNA removal and doublet detection") {

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = Channel.of([
                        [ id: 'test', batch_col: 'sample', counts_layer: 'X' ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679756_filtered_matrix.h5ad', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679756_raw_matrix.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = 'decontx'
                input[2] = ['scrublet']
                input[3] = 1
                """
            }
        }

        then {
            assert workflow.success
            assert snapshot(
                workflow.out.multiqc_files,
                workflow.out.versions,
                anndata(workflow.out.h5ad[0][1]).n_obs,
                anndata(workflow.out.h5ad[0][1]).n_vars
            ).match()
        }

    }

    test("Should apply per-sample QC thresholds from meta") {

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = Channel.of(
                    [
                        [ id: 'loose', batch_col: 'sample', counts_layer: 'X', min_genes: 0, automatic_cell_filtering: false ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679756_filtered_matrix.h5ad', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679756_raw_matrix.h5ad', checkIfExists: true)
                    ],
                    [
                        [ id: 'strict', batch_col: 'sample', counts_layer: 'X', max_mito_percentage: 10 ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679756_filtered_matrix.h5ad', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679756_raw_matrix.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = 'none'
                input[2] = []
                input[3] = 0
                """
            }
        }

        then {
            assert workflow.success
            assert workflow.out.h5ad.size() == 2
            // 'loose' keeps min_genes 0 (not the test-profile 10) and the global
            // max_mito_percentage 25; 'strict' uses min_genes 10 and max_mito_percentage 10.
            // Same input and fixed thresholds, so 'loose' keeps a superset of the cells.
            def loose  = anndata(workflow.out.h5ad.find { it[0].id == 'loose' }[1])
            def strict = anndata(workflow.out.h5ad.find { it[0].id == 'strict' }[1])
            assert loose.n_obs > 0
            assert loose.n_obs >= strict.n_obs
        }

    }

    test("Should run with ambient RNA removal and doublet detection - stub") {

        options '-stub'

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = Channel.of([
                        [ id: 'test', batch_col: 'sample', counts_layer: 'X' ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679756_filtered_matrix.h5ad', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679756_raw_matrix.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = 'decontx'
                input[2] = ['scrublet']
                input[3] = 1
                """
            }
        }

        then {
            assert workflow.success
            assert snapshot(workflow.out).match()
        }

    }

}
