nextflow_process {

    name "Test Process ADATA_ADDMETADATA"
    script "modules/local/adata/addmetadata/main.nf"
    process "ADATA_ADDMETADATA"
    config "./nextflow.config"

    tag "modules"
    tag "modules_local"

    setup {
        run("ADATA_ADDSAMPLE") {
            script "modules/local/adata/addsample/main.nf"
            process {
                """
                input[0] = Channel.of([
                        [id: 'test'],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/combined_filtered_matrix.h5ad', checkIfExists: true)
                    ]
                )
                """
            }
        }
    }

    test("Should run without failures") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = ADATA_ADDSAMPLE.out.h5ad
                input[1] = file("${projectDir}/modules/local/adata/addmetadata/tests/metadata.tsv", checkIfExists: true)
                input[2] = 'sample_id'
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

    test("Should run without failures - stub") {

        options '-stub'

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = ADATA_ADDSAMPLE.out.h5ad
                input[1] = file("${projectDir}/modules/local/adata/addmetadata/tests/metadata.tsv", checkIfExists: true)
                input[2] = 'sample_id'
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
